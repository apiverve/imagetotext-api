{
    "name": "apiverve/imagetotext",
    "description": "Image to Text is an OCR and image to text API that extracts text from image files or remote image URLs using optical character recognition. Upload a JPG, PNG, or GIF up to 5 MB to receive the raw extracted text.",
    "version": "1.2.3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "imagetotext",
        "image to text api",
        "ocr api",
        "free image to text api",
        "text recognition api",
        "extract text from image api"
    ],
    "homepage": "https://apiverve.com/marketplace/imagetotext?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/imagetotext",
        "source": "https://github.com/apiverve/imagetotext-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Imagetotext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Imagetotext\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
